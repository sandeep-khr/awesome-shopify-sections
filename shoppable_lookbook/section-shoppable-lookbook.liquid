{% schema %}
{
  "name": "Shoppable Lookbook",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lookbook Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x_pos",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_pos",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Lookbook",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x_pos": 30,
            "y_pos": 40
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x_pos": 70,
            "y_pos": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="lookbook-section" data-section-id="{{ section.id }}">
  <div class="lookbook-container">
    {% if section.settings.heading != blank %}
      <h2 class="lookbook-header">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="lookbook-image-wrapper">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'lookbook-image' }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-image placeholder-svg' }}
      {% endif %}

      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        
        <div class="lookbook-hotspot" 
             style="left: {{ block.settings.x_pos }}%; top: {{ block.settings.y_pos }}%;"
             {{ block.shopify_attributes }}>
             
          <button class="hotspot-btn" aria-label="View Product">
            <span class="hotspot-dot"></span>
            <span class="hotspot-ring"></span>
          </button>

          <div class="lookbook-card">
            {% if product != blank %}
              <div class="card-image">
                {{ product.featured_image | image_url: width: 300 | image_tag }}
              </div>
              <div class="card-details">
                <h3 class="card-title">{{ product.title }}</h3>
                <p class="card-price">{{ product.price | money }}</p>
                
                <form method="post" action="/cart/add" class="card-form">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="card-atc btn-primary">
                    {% if product.available %}
                      Add to Cart
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                </form>
              </div>
            {% else %}
              <div class="card-details">
                <h3 class="card-title">Select a Product</h3>
                <p class="card-price">$99.00</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  /* Base Styles */
  .lookbook-section {
    padding: 40px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  
  .lookbook-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .lookbook-header {
    text-align: center;
    margin-bottom: 30px;
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 1px;
    color: #333;
  }

  .lookbook-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .lookbook-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  
  .placeholder-svg {
    background: #f0f0f0;
    display: block;
    width: 100%;
    height: 600px; /* Force height for placeholder */
  }

  /* Hotspot Styles */
  .lookbook-hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  .hotspot-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    outline: none;
  }

  .hotspot-dot {
    width: 12px;
    height: 12px;
    background-color: {{ section.settings.hotspot_color }};
    border-radius: 50%;
    z-index: 2;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  }

  .hotspot-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: {{ section.settings.hotspot_color }};
    opacity: 0.5;
    animation: pulse 2s infinite;
    z-index: 1;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.8;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* Product Card Styles (Glassmorphism) */
  .lookbook-card {
    position: absolute;
    bottom: 40px; /* Position above hotspot */
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    width: 250px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 15px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    border: 1px solid rgba(255, 255, 255, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    pointer-events: none;
    z-index: 20;
    text-align: center;
  }
  
  .lookbook-hotspot:hover .lookbook-card,
  .lookbook-hotspot.active .lookbook-card {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  
  /* Triangle indicator */
  .lookbook-card::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    margin-left: -6px;
    border-width: 6px 6px 0;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.9) transparent transparent transparent;
  }

  .card-image img {
    width: 100%;
    height: 150px;
    object-fit: contain;
    margin-bottom: 10px;
    border-radius: 4px;
  }

  .card-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px;
    color: #1a1a1a;
  }

  .card-price {
    font-size: 14px;
    color: #666;
    margin: 0 0 12px;
  }

  .card-atc {
    width: 100%;
    padding: 10px;
    border: none;
    background: #1a1a1a;
    color: white;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .card-atc:hover {
    background: #333;
  }
  
  /* Loading state */
  .card-atc.loading {
    opacity: 0.7;
    cursor: wait;
  }

  /* Responsive Adjustments to keep card on screen */
  /* These detailed logic handled via JS usually, 
     but CSS max-width works for basic bounds */
  @media (max-width: 768px) {
    .lookbook-card {
      width: 200px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Basic Add to Cart functionality
    const forms = document.querySelectorAll('.card-form');
    
    forms.forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const btn = form.querySelector('button');
        const originalText = btn.textContent;
        
        btn.textContent = 'Adding...';
        btn.classList.add('loading');
        
        const formData = new FormData(form);
        
        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => {
          return response.json();
        })
        .then(data => {
          btn.textContent = 'Added!';
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('loading');
          }, 2000);
          
          // Optional: Refresh cart bubble if theme supports it
          // document.dispatchEvent(new CustomEvent('cart:refresh'));
        })
        .catch((error) => {
          console.error('Error:', error);
          btn.textContent = 'Error';
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('loading');
          }, 2000);
        });
      });
    });

    // Mobile Interaction: Click to toggle instead of hover
    const hotspots = document.querySelectorAll('.lookbook-hotspot');
    
    hotspots.forEach(hotspot => {
      hotspot.addEventListener('click', function(e) {
        // Close others
        hotspots.forEach(h => {
          if (h !== hotspot) h.classList.remove('active');
        });
        
        // Toggle current
        this.classList.toggle('active');
      });
    });
    
    // Close on click outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.lookbook-hotspot')) {
         hotspots.forEach(h => h.classList.remove('active'));
      }
    });
  });
</script>
